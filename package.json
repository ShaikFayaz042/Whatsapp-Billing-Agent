{
  "name": "server",
  "version": "1.0.0",
  "description": "WhatsApp billing agent server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:webhook": "node --env-file=.env scripts/test-webhook-signature.mjs",
    "test:billing": "node --test tests/billing.service.test.js",
    "test:validation": "node --test tests/bill-validation.service.test.js",
    "test:translation": "node --test tests/transcription.service.test.js",
    "test:extraction": "node --test tests/parser.service.test.js",
    "test:customers": "node --test tests/customer.service.test.js tests/customer-seed.service.test.js",
    "test:conversation": "node --test tests/bill-draft.service.test.js tests/whatsapp.service.test.js",
    "seed:customers": "node scripts/seed-customers.js"
  },
  "author": "",
  "license": "ISC",
